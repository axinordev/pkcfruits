{
  "name": "pkc-fruits",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "bun scripts/format.mjs",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "payload": "payload",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/plugin-cloud-storage": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "cloudinary": "^2.11.0",
    "cn": "^0.4.0",
    "daisyui": "^5.7.46",
    "framer-motion": "^13.4.4",
    "graphql": "16.8.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "payload": "^3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,css,md,mdx}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "bun@1.3.10",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
