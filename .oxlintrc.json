{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "react",
    "nextjs",
    "import",
    "jsx-a11y",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@payloadcms/next/css"]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "typescript/no-explicit-any": "warn"
  },
  "overrides": [
    {
      "files": ["lib/seed/**/*.ts"],
      "rules": {
        "eslint/no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "build/**",
    "next-env.d.ts",
    "payload-types.ts",
    "app/(payload)/axinor/administrate/importMap.js"
  ]
}
